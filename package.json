{
	"name": "dynamic-island-svelte",
	"version": "0.1.0",
	"description": "A Dynamic Island-style surface for Svelte 5. One black pill, one spring, and the states you write.",
	"license": "MIT",
	"type": "module",
	"keywords": ["svelte", "svelte5", "dynamic-island", "ui", "animation", "spring"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EmilM32/dynamic-island-svelte.git"
	},
	"homepage": "https://dynamic-island-svelte.vercel.app",
	"bugs": {
		"url": "https://github.com/EmilM32/dynamic-island-svelte/issues"
	},
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 4731",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4731",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": ["dist", "docs/demo.png", "!dist/**/*.test.*", "!dist/**/*.spec.*"],
	"sideEffects": ["**/*.css"],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
